# Copy this file to .env.local and fill in real values from your Firebase
# project (console.firebase.google.com -> Project settings -> Your apps ->
# Web app -> SDK setup and configuration -> Config). .env.local is already
# gitignored (matches the *.local pattern) so real keys never get committed.
#
# Without this file, the game still runs fully as a guest — sign-in is simply
# disabled until these are set.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
